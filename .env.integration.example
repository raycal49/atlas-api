# Environment for the integration test suite. Copy it as-is, no edits needed:
#
#     cp .env.integration.example .env.integration
#
# `npm run test:integration` loads `.env.integration` via --env-file. CI copies
# this same file, so what runs there and what runs on your machine cannot drift.
#
# Nothing here is a secret. The database credentials are already public in
# compose.integration.yml, and the JWT key below only ever signs tokens that
# the same test run verifies.

# Required by src/tests/integration/testDb.js, which refuses to run otherwise.
# It is also what keeps cookies non-Secure so supertest can read them back.
NODE_ENV=test

# Must match compose.integration.yml exactly. testDb.js asserts on the host,
# port, database and user before connecting, so a stray value cannot point the
# truncating test suite at a real database.
DATABASE_URL=postgres://postgres:geoapp_test@127.0.0.1:55432/geoapp_test

# The test container speaks plain TCP.
DATABASE_SSL_MODE=disable

# Signs the token cookies minted in src/tests/integration/authFixtures.js and
# verified by the real authMiddleware. Fake by design -- but it must be set, or
# src/config/jwt.js throws at import and the whole suite fails to load.
JWT_SECRET=integration-test-secret-not-a-real-key
