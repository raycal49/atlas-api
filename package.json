{
  "name": "atlas-api",
  "version": "0.1.0",
  "description": "Geospatial API platform with metered usage, plans, and billing.",
  "keywords": [
    "express",
    "postgresql",
    "rest-api",
    "billing"
  ],
  "license": "MIT",
  "author": "Raymond Calderon",
  "repository": {
    "type": "git",
    "url": "github:raycal49/atlas-api"
  },
  "engines": {
    "node": ">=22"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "docker compose up -d --wait && npm run seed:usage",
    "start": "node --env-file-if-exists=.env ./src/server.js",
    "dev": "node --watch --env-file-if-exists=.env ./src/server.js",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\"",
    "seed:usage": "node --env-file-if-exists=.env ./src/scripts/seedUsage.js",
    "seed:usage:reset": "node --env-file-if-exists=.env ./src/scripts/seedUsage.js --reset",
    "test": "vitest --config vitest.unit.config.js",
    "test:run": "vitest run --config vitest.unit.config.js",
    "test:integration": "node --env-file=.env.integration ./node_modules/vitest/vitest.mjs run --config vitest.integration.config.js",
    "db:integration:up": "docker compose -f compose.integration.yml up --wait",
    "db:integration:ps": "docker compose -f compose.integration.yml ps",
    "db:integration:logs": "docker compose -f compose.integration.yml logs db",
    "db:integration:shell": "docker compose -f compose.integration.yml exec db psql -U postgres -d geoapp_test",
    "db:integration:down": "docker compose -f compose.integration.yml down",
    "db:integration:destroy": "docker compose -f compose.integration.yml down -v"
  },
  "dependencies": {
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "debug": "^4.4.3",
    "express": "^5.2.1",
    "jose": "^6.2.3",
    "morgan": "^1.11.0",
    "postgres": "^3.4.9",
    "status": "^0.0.13",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "dotted-map": "^3.1.0",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "vitest": "^4.1.10"
  }
}
