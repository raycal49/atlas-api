# Every environment variable this application reads. Copy to `.env` and fill
# in real values:  cp .env.example .env
#
# `npm start` and `npm run dev` load `.env` automatically. The values below are
# placeholders -- the real ones are secrets and must never be committed.
#
# For running the integration test suite, use `.env.integration.example`
# instead; it ships with working values and can be copied as-is.

# Port the HTTP server listens on. Optional -- see src/www.js for the default.
PORT=3000

# 'production' enables Secure-only cookies (src/config/cookies.js).
# Anything else, including this value, keeps them readable over plain http.
NODE_ENV=development

# Postgres connection string. Required -- createDb() throws without it.
DATABASE_URL=postgres://user:password@host:5432/database

# Must be exactly 'require' or 'disable'. Required -- any other value throws.
# Use 'require' for a hosted database, 'disable' for local Postgres.
DATABASE_SSL_MODE=require

# Set to 'true' to log every SQL statement and its parameters. Optional.
DATABASE_LOG_QUERIES=false

# Key used to sign and verify session JWTs. Required -- the app refuses to
# start without it (src/config/jwt.js).
#
# Generate a real one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string
